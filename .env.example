# ===== Geo-Strategist AI — Root .env.example =====
# Copy to `.env` at repo root and fill values as needed.

# Base URLs & Ports
PUBLIC_BASE_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8001
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Ollama Models (tweak to your local tags)
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_REASONING_MODEL=gemma3:4b
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# Google Maps (optional but enables geocoding/nearby)
GOOGLE_MAPS_API_KEY=your_maps_key
GOOGLE_MAPS_BROWSER_API_KEY=your_browser_key
EXPOSE_SERVER_MAPS_KEY_TO_FRONTEND=0

# Google OAuth (used for Sign-in + Sheets)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Notion OAuth (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_AUTH_URL=https://api.notion.com/v1/oauth/authorize
NOTION_OAUTH_TOKEN_URL=https://api.notion.com/v1/oauth/token

# Discord OAuth (optional) + Bot token for REST
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Canva (optional; for Apps OAuth + template handoff)
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
OAUTH_CANVA_AUTH_URL=https://example.canva.auth/authorize
OAUTH_CANVA_TOKEN_URL=https://example.canva.auth/token
CANVA_SCOPES=
CANVA_TEMPLATE_URL=
CANVA_BRAND_COLORS=#6420FF,#111111,#FFFFFF

# Email (optional; for /integrations/send-email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=me@example.com
SMTP_PASS=app_password
SMTP_TLS=1

# Social/API tokens (all optional; services fall back to public search)
TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=geo-strategist/1.0
YOUTUBE_API_KEY=
TRELLO_API_KEY=
TRELLO_API_TOKEN=
SENDGRID_API_KEY=
UNSPLASH_ACCESS_KEY=

# Dev bootstrap
# Set to 1 to skip auto-pip install when starting backend/main.py
SKIP_BOOTSTRAP=0
