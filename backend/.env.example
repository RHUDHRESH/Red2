# ===== Backend .env.example =====
# Copy to `.env` inside geo_strategist_app/backend and adjust as needed.

# Public URL of this backend (used for OAuth redirects)
PUBLIC_BASE_URL=http://localhost:8000

# ChromaDB connection (use 8001 to avoid conflict with backend 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Ollama connection + default models
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_REASONING_MODEL=gemma3:4b
OLLAMA_EMBEDDINGS_MODEL=jina-embeddings-v2-base-en

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=your_maps_key
GOOGLE_MAPS_BROWSER_API_KEY=your_browser_key
EXPOSE_SERVER_MAPS_KEY_TO_FRONTEND=0

# Google OAuth (optional; for Sign-in + Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion OAuth (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_AUTH_URL=https://api.notion.com/v1/oauth/authorize
NOTION_OAUTH_TOKEN_URL=https://api.notion.com/v1/oauth/token

# Discord OAuth (optional) + Bot token for REST
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Canva (optional; for Apps OAuth + template handoff)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
OAUTH_CANVA_AUTH_URL=
OAUTH_CANVA_TOKEN_URL=
CANVA_SCOPES=

# New Integrations
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=geo-strategist/1.0
YOUTUBE_API_KEY=
TRELLO_API_KEY=
TRELLO_API_TOKEN=
SENDGRID_API_KEY=
UNSPLASH_ACCESS_KEY=

# Dev bootstrap
# Set to 1 to skip auto-pip install when starting backend/main.py
SKIP_BOOTSTRAP=0
